{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "tests"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "file", "line", "description", "required_fix"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "title": {"type": "string"},
          "file": {"type": "string"},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "description": {"type": "string"},
          "required_fix": {"type": "string"}
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
