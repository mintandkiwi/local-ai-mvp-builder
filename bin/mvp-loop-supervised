#!/bin/sh
set -eu

SOURCE=$0
while [ -h "$SOURCE" ]; do
  SOURCE_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
  LINK=$(readlink "$SOURCE")
  case "$LINK" in
    /*) SOURCE=$LINK ;;
    *) SOURCE=$SOURCE_DIR/$LINK ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

usage() {
  cat <<'EOF'
用法：mvp-loop-supervised --project PATH --plan FILE [选项]

运行带前置基线、风险路由、Token 计量和自适应 review 的受监督 MVP 工作流。

必需参数：
  --project PATH           目标 Git 项目目录
  --plan FILE              已批准的项目计划

选项：
  --model primary|secondary  本地模型别名（默认：primary）
  --display summary|live     输出模式（默认：summary）
  -h, --help                 显示帮助

该入口固定拒绝脏工作区，且不接受 --allow-dirty。计划必须声明
Risk classification: low|medium|high；未声明按 high 直接云端监督处理。
模型修改前会在可丢弃副本中运行可写干净基线；失败时 local/cloud 调用数均为 0。
用量、接管原因、预算状态和 no_baseline 证据写入 summary.json。
EOF
}

PROJECT=
PLAN=
MODEL=primary
DISPLAY=summary

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --project|--plan|--model|--display)
      if [ "$#" -lt 2 ]; then
        echo "错误：$1 缺少参数值" >&2
        usage >&2
        exit 2
      fi
      case "$1" in
        --project) PROJECT=$2 ;;
        --plan) PLAN=$2 ;;
        --model) MODEL=$2 ;;
        --display) DISPLAY=$2 ;;
      esac
      shift 2
      ;;
    --allow-dirty)
      echo "错误：受监督入口不允许 --allow-dirty" >&2
      exit 2
      ;;
    *)
      echo "错误：未知参数 $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [ -z "$PROJECT" ] || [ -z "$PLAN" ]; then
  echo "错误：--project 和 --plan 均为必需参数" >&2
  usage >&2
  exit 2
fi
case "$MODEL" in
  primary|secondary) ;;
  *)
    echo "错误：--model 只能是 primary 或 secondary" >&2
    exit 2
    ;;
esac
case "$DISPLAY" in
  summary|live) ;;
  *)
    echo "错误：--display 只能是 summary 或 live" >&2
    exit 2
    ;;
esac

if [ ! -d "$PROJECT" ]; then
  echo "错误：项目目录不存在：$PROJECT" >&2
  exit 1
fi
PROJECT=$(CDPATH= cd -- "$PROJECT" && pwd -P)
if [ ! -f "$PLAN" ]; then
  echo "错误：计划文件不存在：$PLAN" >&2
  exit 1
fi
PLAN_DIR=$(CDPATH= cd -- "$(dirname -- "$PLAN")" && pwd -P)
PLAN=$PLAN_DIR/$(basename -- "$PLAN")

if [ "$DISPLAY" = live ]; then
  exec python3 "$REPO_ROOT/src/mvp_orchestrator.py" run \
    --project "$PROJECT" --plan "$PLAN" --model "$MODEL" --live
fi
exec python3 "$REPO_ROOT/src/mvp_orchestrator.py" run \
  --project "$PROJECT" --plan "$PLAN" --model "$MODEL"
